{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid)",
        ".validate": "$code.matches(/^[A-Z]{4}$/) && newData.hasChildren(['hostUid', 'status'])",

        "status": {
          ".write": "auth != null && data.val() === 'playing' && newData.val() === 'finished'",
          ".validate": "newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'finished'"
        },
        "endReason": {
          ".write": "auth != null && data.parent().child('status').val() === 'playing' && newData.val() === 'survivors'"
        },
        "sabotageDelay": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3600"
        },
        "killers": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20"
        },
        "sheriffs": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20"
        },

        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.child('pseudo').isString() && newData.child('pseudo').val().length <= 24"
          }
        },

        "tasks": {
          "$taskId": {
            ".write": "auth != null && data.exists() && newData.exists() && root.child('rooms').child($code).child('status').val() === 'playing'",
            ".validate": "newData.hasChildren(['title', 'status']) && (newData.parent().parent().child('hostUid').val() === auth.uid || (newData.child('title').val() === data.child('title').val() && newData.child('location').val() === data.child('location').val()))",
            "status": {
              ".validate": "newData.val() === 'pending' || newData.val() === 'completed' || newData.val() === 'sabotaged'"
            }
          }
        }
      }
    },

    "roles": {
      "$code": {
        ".write": "auth != null && root.child('rooms').child($code).child('hostUid').val() === auth.uid",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".validate": "newData.child('role').val() === 'TUEUR' || newData.child('role').val() === 'SHERIFF' || newData.child('role').val() === 'SURVIVANT'"
        }
      }
    }
  }
}
