{
  "rules": {
    "config": {
      ".read": false,
      ".write": false
    },

    "members": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && root.child('config').child('password').exists() && newData.val() === root.child('config').child('password').val()"
      }
    },

    "access": {
      ".read": "auth != null && root.child('config').child('password').exists() && root.child('members').child(auth.uid).val() === root.child('config').child('password').val()"
    },

    "rooms": {
      "$code": {
        ".read": "auth != null && root.child('config').child('password').exists() && root.child('members').child(auth.uid).val() === root.child('config').child('password').val()",
        ".write": "auth != null && root.child('config').child('password').exists() && root.child('members').child(auth.uid).val() === root.child('config').child('password').val() && (!data.exists() || data.child('hostUid').val() === auth.uid)",
        ".validate": "$code.matches(/^[A-Z]{4}$/) && newData.hasChildren(['hostUid', 'status'])",

        "status": {
          ".write": "auth != null && root.child('config').child('password').exists() && root.child('members').child(auth.uid).val() === root.child('config').child('password').val() && data.val() === 'playing' && newData.val() === 'finished'",
          ".validate": "newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'finished'"
        },
        "endReason": {
          ".write": "auth != null && root.child('config').child('password').exists() && root.child('members').child(auth.uid).val() === root.child('config').child('password').val() && data.parent().child('status').val() === 'playing' && newData.val() === 'survivors'"
        },
        "sabotageDelay": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3600"
        },
        "killers": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20"
        },
        "sheriffs": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20"
        },
        "victoryDelay": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 600"
        },
        "taskCount": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50"
        },

        "powerSettings": {
          "startCooldown": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3600" },
          "cooldown": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3600" },
          "$power": {
            "enabled": { ".validate": "newData.isBoolean()" },
            "duration": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3600" },
            "maxUses": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99" },
            "$other": { ".validate": false }
          }
        },

        "power": {
          ".write": "auth != null && root.child('config').child('password').exists() && root.child('members').child(auth.uid).val() === root.child('config').child('password').val() && root.child('rooms').child($code).child('status').val() === 'playing' && root.child('roles').child($code).child(auth.uid).child('role').val() === 'TUEUR'"
        },

        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('config').child('password').exists() && root.child('members').child(auth.uid).val() === root.child('config').child('password').val()",
            ".validate": "newData.child('pseudo').isString() && newData.child('pseudo').val().length <= 24"
          }
        },

        "tasks": {
          "$taskId": {
            ".write": "auth != null && root.child('config').child('password').exists() && root.child('members').child(auth.uid).val() === root.child('config').child('password').val() && data.exists() && newData.exists() && root.child('rooms').child($code).child('status').val() === 'playing'",
            ".validate": "newData.hasChildren(['title', 'status']) && (newData.parent().parent().child('hostUid').val() === auth.uid || (newData.child('title').val() === data.child('title').val() && newData.child('location').val() === data.child('location').val() && newData.child('todo').val() === data.child('todo').val() && newData.child('sabotage').val() === data.child('sabotage').val())) && (newData.child('status').val() !== 'completed' || data.child('status').val() === 'completed' || root.child('rooms').child($code).child('power').child('active').child('type').val() !== 'block' || root.child('rooms').child($code).child('power').child('active').child('until').val() <= now)",
            "status": {
              ".validate": "newData.val() === 'pending' || newData.val() === 'completed' || newData.val() === 'sabotaged'"
            }
          }
        }
      }
    },

    "catalog": {
      ".read": "auth != null && root.child('config').child('password').exists() && root.child('members').child(auth.uid).val() === root.child('config').child('password').val()",
      ".write": "auth != null && root.child('config').child('password').exists() && root.child('members').child(auth.uid).val() === root.child('config').child('password').val() && !data.exists()",
      "$id": {
        ".write": "auth != null && root.child('config').child('password').exists() && root.child('members').child(auth.uid).val() === root.child('config').child('password').val()",
        ".validate": "newData.child('title').isString() && newData.child('title').val().length >= 1 && newData.child('title').val().length <= 60",
        "title": { ".validate": "newData.isString()" },
        "category": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "location": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "todo": { ".validate": "newData.isString() && newData.val().length <= 600" },
        "sabotage": { ".validate": "newData.isString() && newData.val().length <= 600" },
        "enabled": { ".validate": "newData.isBoolean()" },
        "order": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "roles": {
      "$code": {
        ".write": "auth != null && root.child('config').child('password').exists() && root.child('members').child(auth.uid).val() === root.child('config').child('password').val() && root.child('rooms').child($code).child('hostUid').val() === auth.uid",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid && root.child('config').child('password').exists() && root.child('members').child(auth.uid).val() === root.child('config').child('password').val()",
          ".validate": "newData.child('role').val() === 'TUEUR' || newData.child('role').val() === 'SHERIFF' || newData.child('role').val() === 'SURVIVANT'"
        }
      }
    }
  }
}
